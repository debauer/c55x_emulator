+        if (page_end > end)
+            page_end = end;
+
+        block = (memblock_t *) start;
+        block->size = page_end - start;
+        block->user = NULL;
+        block->tag = PU_FREE;
+        block->id = ZONEID;
+        block->prev = prev;
+        prev->next = block;
+        prev = block;
+
+        if (page_end >= end)
+            break;
+
+        // barrier: a static block of just its header at the start of the next page
+        block = (memblock_t *) page_end;
+        block->size = sizeof(memblock_t);
+        block->user = (void *) block;
+        block->tag = PU_STATIC;
+        block->id = ZONEID;
+        block->prev = prev;
+        prev->next = block;
+        prev = block;
+        start = page_end + sizeof(memblock_t);
+    }
+    prev->next = &zone->blocklist;
+    zone->blocklist.prev = prev;
